    {
      "parameters": {
        "jsCode": "const original = $('Mensagem pronta').item.json.number;\nconst text = $('Mensagem pronta').item.json.text;\nconst digits = original.replace('@s.whatsapp.net', '');\nconst prefix = digits.slice(0, 4);\nconst rest = digits.slice(4);\nconst altRest = rest.length === 9 ? rest.slice(1) : `9${rest}`;\nconst altDigits = `${prefix}${altRest}`;\n\nreturn [{ json: { text, candidatos: [digits, altDigits] } }];"
      },
