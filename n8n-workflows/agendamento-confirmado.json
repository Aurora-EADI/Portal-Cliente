    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Erro de infra na Evolution (ex.: \"Connection Closed\") nao pode virar\n// \"numero nao existe\" — sao causas diferentes e tratamentos diferentes.\nconst falhou = items.find(i => i.json.error !== undefined);\nif (falhou) {\n  const e = falhou.json.error;\n  const msg = typeof e === 'string' ? e : (e?.message || 'erro desconhecido');\n  return [{ json: { error: { message: `Falha ao checar números na Evolution API: ${msg}` } } }];\n}\n\nconst valido = items.find(i => i.json.exists === true);\nconst text = $('Montar variantes de número').first().json.text;\n\nif (valido) {\n  return [{ json: { number: valido.json.jid, text } }];\n}\n\nreturn [{ json: { error: { message: `Número não existe no WhatsApp em nenhum formato testado: ${items.map(i => i.json.number).join(', ')}` } } }];"
      },
