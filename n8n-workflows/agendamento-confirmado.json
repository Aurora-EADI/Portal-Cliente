        1040,
        1472
      ]
    },
    {
      "parameters": {
        "jsCode": "const digits = ($json.body.whatsapp || '').replace(/\\D/g, '');\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\nconst text = `Olá! Seu agendamento foi confirmado.\\n\\n` +\n  `Protocolo: ${$json.body.protocolo}\\n` +\n  `Data: ${$json.body.data}  Horário: ${$json.body.horario}\\n` +\n  ($json.body.empresa ? `Empresa: ${$json.body.empresa}\\n` : '') +\n  ($json.body.operacao ? `Operação: ${$json.body.operacao}\\n` : '') +\n  ($json.body.diNumero ? `D.I: ${$json.body.diNumero}\\n` : '') +\n  ($json.body.container ? `Container: ${$json.body.container}\\n` : '') +\n  ($json.body.nomeMotorista ? `Motorista: ${$json.body.nomeMotorista}\\n` : '') +\n  ($json.body.placaVeiculo ? `Veículo: ${$json.body.placaVeiculo}\\n` : '') +\n  ($json.body.transportadora ? `Transportadora: ${$json.body.transportadora}\\n` : '') +\n  `\\nAurora EADI — Portal do Cliente`;\n\nreturn [{ json: { number, text } }];"
      },
      "id": "d2eadfa7-f927-41c0-b37c-fe0219c52233",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        1712
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\n\nconst digits = (body.whatsapp || '').replace(/\\D/g, '');\nif (digits.length < 10) return [];\n\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\n// $env é bloqueado neste n8n (N8N_BLOCK_ENV_ACCESS_IN_NODE), então a URL\n// pública fica aqui. Ao virar produção, trocar por auroraeadi.com.br.\nconst PORTAL_URL = 'https://portal-cliente.auroraeadi.com.br/';\nconst SAC = '(92) 98277-2168';\n\n// \"JR ASSESSORIA\" -> \"Jr Assessoria\" (evita tom de banco de dados)\nconst nome = (body.nome || 'cliente')\n  .toLowerCase()\n  .replace(/(^|\\s|\\/)\\p{L}/gu, (c) => c.toUpperCase());\n\nconst lotes = body.lotes || [];\nif (lotes.length === 0) return [];\n\nconst multi = lotes.length > 1;\n\nconst listaLotes = lotes\n  .map((l) => {\n    const linhas = [`📦 Lote: *${l.nLote}*`];\n    if (l.documento) linhas.push(`📄 Documento: ${l.documento}`);\n    return linhas.join('\\n');\n  })\n  .join('\\n\\n');\n\nconst text =\n  `Olá, *${nome}*! 👋\\n\\n` +\n  `Aqui é a equipe da *Aurora EADI*.\\n\\n` +\n  `${multi ? 'As averbações dos lotes' : 'A averbação do lote'} abaixo ` +\n  `${multi ? 'foram concluídas' : 'foi concluída'} ✅\\n\\n` +\n  `${listaLotes}\\n\\n` +\n  `Já ${multi ? 'estão liberados' : 'está liberado'} para *agendamento* no Portal do Cliente:\\n` +\n  `${PORTAL_URL}/agendamento\\n\\n` +\n  `Qualquer dúvida, fale com nosso SAC:\\n` +\n  `📞 ${SAC}\\n\\n` +\n  `_Aurora EADI — Portal do Cliente_`;\n\nreturn [{ json: { number, text, linkPreview: true } }];\n"
      },
      "id": "d658e4ab-10da-4088-81b3-73dd1130d070",
      "name": "Montar mensagem (averbação)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
