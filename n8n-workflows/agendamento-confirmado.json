    {
      "parameters": {
        "jsCode": "const digits = ($json.body.whatsapp || '').replace(/\\D/g, '');\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\nconst di = $json.body.documentoSaida || $json.body.nLote;\nconst text = `Olá! A transportadora *${$json.body.transportadora}* foi atribuída para a retirada da DI ${di}.\\n\\n` +\n  ($json.body.cliente ? `Cliente: ${$json.body.cliente}\\n` : '') +\n  `\\nAcesse o Portal do Cliente Aurora EADI para agendar a retirada:\\nhttp://host.docker.internal:3002/\\n\\n` +\n  `Aurora EADI — Portal do Cliente`;\n\nreturn [{ json: { number, text } }];"
      },
      "id": "315d84c7-90ef-431c-818c-99d77b982da6",
      "name": "Montar mensagem (atribuição)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const digits = ($json.body.whatsapp || '').replace(/\\D/g, '');\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\nconst text = `Olá! Seu agendamento foi confirmado.\\n\\n` +\n  `Protocolo: ${$json.body.protocolo}\\n` +\n  `Data: ${$json.body.data}  Horário: ${$json.body.horario}\\n` +\n  ($json.body.empresa ? `Empresa: ${$json.body.empresa}\\n` : '') +\n  ($json.body.operacao ? `Operação: ${$json.body.operacao}\\n` : '') +\n  ($json.body.diNumero ? `D.I: ${$json.body.diNumero}\\n` : '') +\n  ($json.body.container ? `Container: ${$json.body.container}\\n` : '') +\n  ($json.body.nomeMotorista ? `Motorista: ${$json.body.nomeMotorista}\\n` : '') +\n  ($json.body.placaVeiculo ? `Veículo: ${$json.body.placaVeiculo}\\n` : '') +\n  ($json.body.transportadora ? `Transportadora: ${$json.body.transportadora}\\n` : '') +\n  `\\nAurora EADI — Portal do Cliente`;\n\nreturn [{ json: { number, text } }];"
      },
      "id": "d9d18f74-12ea-44a7-9d03-201c43ed1490",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        624
      ]
    },
    {
      "parameters": {
        "jsCode": "const digits = ($json.body.whatsapp || '').replace(/\\D/g, '');\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\nconst lotes = $json.body.lotes || [];\nconst plural = lotes.length > 1 ? 's' : '';\nconst listaLotes = lotes\n  .map(l => `• Lote ${l.nLote}${l.documento ? ` (Doc: ${l.documento})` : ''}`)\n  .join('\\n');\n\nconst text = `Olá, ${$json.body.nome}!\\n\\n` +\n  `A averbação do${plural} lote${plural} abaixo foi concluída:\\n\\n` +\n  `${listaLotes}\\n\\n` +\n  `Já está disponível para agendamento no Portal do Cliente Aurora EADI:\\n` +\n  `http://host.docker.internal:3002/\\n\\n` +\n  `Aurora EADI — Portal do Cliente`;\n\nreturn [{ json: { number, text } }];"
      },
      "id": "ac5bee55-29a7-4957-b292-8e6b7805e83a",
      "name": "Montar mensagem (averbação)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        864
      ]
    },
    {
      "parameters": {
        "jsCode": "const digits = ($json.body.whatsapp || '').replace(/\\D/g, '');\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\nconst tipoLabel = { DESPACHANTE: 'despachante', CLIENTE: 'cliente', TRANSPORTADORA: 'transportadora' }[$json.body.destinatario] || 'usuário';\n\nlet expiraTexto = '';\ntry {\n  const dt = new Date($json.body.expiresAt);\n  expiraTexto = dt.toLocaleDateString('pt-BR');\n} catch (e) {\n  expiraTexto = $json.body.expiresAt || '';\n}\n\nconst text = `Olá, ${$json.body.nome}!\\n\\n` +\n  `Você foi convidado(a) como ${tipoLabel} para acessar o Portal do Cliente Aurora EADI.\\n\\n` +\n  `Acesse o link abaixo para concluir seu cadastro:\\n${$json.body.link}\\n\\n` +\n  (expiraTexto ? `Este convite expira em ${expiraTexto}.\\n\\n` : '') +\n  `Aurora EADI — Portal do Cliente`;\n\nreturn [{ json: { number, text } }];"
      },
