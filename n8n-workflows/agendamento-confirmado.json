    {
      "parameters": {
        "jsCode": "// Estourou o limite de restarts: a instancia nao volta sozinha.\n// Normalmente significa credencial invalidada (deslogado no celular) — precisa reparear via QR:\n// GET http://evolution_api:8080/instance/connect/wtsp\nconst estado = $('Normalizar estado').first().json;\nconst detalhe = estado.detalhe ? ` (${estado.detalhe})` : '';\n\nreturn [{ json: { error: { message: `Instância wtsp não conectou após 3 restarts. Estado: ${estado.state}${detalhe}. Verifique se precisa reparear o QR Code.` } } }];"
      },
      "id": "852899d5-a728-42ba-81b5-61e552e148c8",
      "name": "Falha de conexão",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1968,
        2032
      ]
    },
    {
      "parameters": {
        "jsCode": "// .first() em vez de .item: apos o loop de reconexao (que passa por Wait)\n// o pareamento de itens se perde e $('...').item lanca erro.\nconst original = $('Mensagem pronta').first().json.number;\nconst text = $('Mensagem pronta').first().json.text;\nconst digits = original.replace('@s.whatsapp.net', '');\nconst prefix = digits.slice(0, 4);\nconst rest = digits.slice(4);\nconst altRest = rest.length === 9 ? rest.slice(1) : `9${rest}`;\nconst altDigits = `${prefix}${altRest}`;\n\nreturn [{ json: { text, candidatos: [digits, altDigits] } }];"
      },
