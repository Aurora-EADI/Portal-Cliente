    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\n\nconst digits = (body.whatsapp || '').replace(/\\D/g, '');\nif (digits.length < 10) return [];\n\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\n// $env é bloqueado neste n8n (N8N_BLOCK_ENV_ACCESS_IN_NODE), então a URL\n// pública fica aqui. Ao virar produção, trocar por auroraeadi.com.br.\nconst PORTAL_URL = 'https://homologacao.auroraeadi.com.br';\nconst SAC = '(92) 98277-2168';\nconst TZ = 'America/Manaus';\n\n// O WhatsApp só transforma em link o que tem protocolo e domínio público.\n// localhost / host.docker.internal não viram link nem geram preview, então\n// reescrevemos para o domínio real antes de montar a mensagem.\nfunction normalizarLink(raw) {\n  if (!raw) return '';\n  let url = String(raw).trim();\n  if (!/^https?:\\/\\//i.test(url)) url = `https://${url}`;\n  try {\n    const u = new URL(url);\n    if (/^(host\\.docker\\.internal|localhost|127\\.0\\.0\\.1|\\[::1\\])$/i.test(u.hostname)) {\n      const base = new URL(PORTAL_URL);\n      u.protocol = base.protocol;\n      u.hostname = base.hostname;\n      u.port = base.port; // '' quando o domínio usa 443\n    }\n    return u.toString();\n  } catch (e) {\n    return url;\n  }\n}\n\nconst link = normalizarLink(body.link);\nif (!link) return [];\n\nconst tipoLabel = {\n  DESPACHANTE: 'despachante',\n  CLIENTE: 'cliente',\n  TRANSPORTADORA: 'transportadora',\n}[body.destinatario] || 'usuário';\n\n// new Date('lixo') devolve Invalid Date sem lançar — checar com isNaN\nconst dt = body.expiresAt ? new Date(body.expiresAt) : null;\nconst dtValida = dt && !isNaN(dt.getTime());\n\nconst expiraTexto = dtValida\n  ? dt.toLocaleString('pt-BR', {\n      timeZone: TZ,\n      day: '2-digit',\n      month: '2-digit',\n      year: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit',\n    })\n  : '';\n\nconst diasRestantes = dtValida\n  ? Math.ceil((dt.getTime() - Date.now()) / 86400000)\n  : null;\n\nconst prazo = diasRestantes !== null && diasRestantes > 0\n  ? ` (${diasRestantes} dia${diasRestantes > 1 ? 's' : ''})`\n  : '';\n\nconst nome = (body.nome || '')\n  .toLowerCase()\n  .replace(/(^|\\s|\\/)\\p{L}/gu, (c) => c.toUpperCase());\n\nconst linhas = [\n  `Olá${nome ? `, *${nome}*` : ''}! 👋`,\n  '',\n  'Aqui é a equipe da *Aurora EADI*.',\n  '',\n  `Você foi convidado como *${tipoLabel}* para acessar o Portal do Cliente.`,\n  '',\n  'Toque no link abaixo para criar sua senha e concluir o cadastro:',\n  link,\n  '',\n];\n\nlinhas.push(\n  '🔒 Este link é pessoal. Não encaminhe para outras pessoas.',\n  '',\n  'Qualquer dúvida, fale com nosso SAC:',\n  `📞 ${SAC}`,\n  '',\n  '_Aurora EADI — Portal do Cliente_',\n);\n\nreturn [{ json: { number, text: linhas.join('\\n'), linkPreview: true } }];\n"
      },
