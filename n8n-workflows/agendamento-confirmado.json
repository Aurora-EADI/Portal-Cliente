    {
      "parameters": {
        "jsCode": "// Normaliza a resposta do /instance/connectionState.\n// Se o node HTTP falhou (onError: continueRegularOutput), o item vem como { error: ... }\n// e $json.instance.state nao existe — sem isso o IF quebra com typeValidation strict.\nconst j = $json || {};\n\nif (j.error !== undefined) {\n  const msg = typeof j.error === 'string' ? j.error : (j.error?.message || 'erro desconhecido');\n  return [{ json: { state: 'unreachable', detalhe: msg } }];\n}\n\nconst state = j?.instance?.state || j?.state || 'unknown';\nreturn [{ json: { state, detalhe: '' } }];"
      },
