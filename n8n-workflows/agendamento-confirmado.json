    {
      "parameters": {
        "jsCode": "const digits = ($json.body.whatsapp || '').replace(/\\D/g, '');\nconst withCountry = digits.startsWith('55') ? digits : `55${digits}`;\nconst number = `${withCountry}@s.whatsapp.net`;\n\nconst portalUrl = String($env.PORTAL_CLIENTE_URL || '').replace(/\\/+$/, '');\nif (!portalUrl) throw new Error('PORTAL_CLIENTE_URL não configurada');\n\nconst b = $json.body;\nconst di = b.documentoSaida || b.nLote;\n// A mensagem vai para o WhatsApp da transportadora atribuída.\nconst nome = b.nome || b.transportadora;\n\nconst text =\n  `Olá, *${nome}*! 👋\\n\\n` +\n  `Aqui é a equipe da *Aurora EADI*.\\n\\n` +\n  `A transportadora *${b.transportadora}* foi atribuída para a retirada da DI *${di}* 🚛\\n\\n` +\n  (b.cliente ? `🏢 Cliente: ${b.cliente}\\n\\n` : '') +\n  `Acesse o Portal do Cliente para *agendar a retirada*:\\n` +\n  `${portalUrl}/agendamento\\n\\n` +\n  `Qualquer dúvida, fale com nosso SAC:\\n` +\n  `📞 (92) 98277-2168\\n\\n` +\n  `_Aurora EADI — Portal do Cliente_`;\n\nreturn [{ json: { number, text } }];\n"
      },
      "id": "129e9e43-3674-4e75-8e39-ce818ca124a2",
      "name": "Montar mensagem (atribuição)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
