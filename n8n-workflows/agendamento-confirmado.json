    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst valido = items.find(i => i.json.exists === true);\n\nif (valido) {\n  return [{ json: { number: valido.json.jid, text: $('Montar variantes de número').item.json.text } }];\n}\n\nreturn [{ json: { error: { message: `Número não existe no WhatsApp em nenhum formato testado: ${items.map(i => i.json.number).join(', ')}` } } }];"
      },
