# Template do ambiente de HOMOLOGAÇÃO (VM 172.20.210.87).
# Copie para .env.homolog NA VM, preencha os SUBSTITUA_ME e aplique chmod 600.
# O .env.homolog nunca vai para o git.
#
# Runbook: doc/HOMOLOGACAO.md. Separação em relação à produção: doc/AMBIENTES.md.

NODE_ENV=production

# ─── Host e portas ────────────────────────────────────────────────────────────
# 80/443 da VM pertencem à homologação do Portal Aurora; esta stack usa portas
# altas. HOMOLOG_HOST é o que entra nas regras Host() do Traefik — o Traefik
# casa Host() ignorando a porta, então o IP puro basta.
HOMOLOG_HOST=172.20.210.87
HOMOLOG_HTTP_PORT=8090
HOMOLOG_HTTPS_PORT=8453

# Ao trocar HOMOLOG_HTTPS_PORT, atualize também o `to:` do redirect em
# docker/traefik/traefik.homolog.yml — lá o valor é estático.

# ─── URLs ─────────────────────────────────────────────────────────────────────
# /api é same-origin: o Traefik roteia /api para a API e o resto para o front.
API_URL=/api
FRONTEND_URL=https://172.20.210.87:8453
BETTER_AUTH_URL=https://172.20.210.87:8453

# Duas listas independentes, e as duas precisam da origem com a porta:
# BETTER_AUTH_TRUSTED_ORIGINS valida a origem do login (better-auth.ts) e
# CORS_ORIGIN governa o browser (main.ts). CSV, sem barra final.
BETTER_AUTH_TRUSTED_ORIGINS=https://172.20.210.87:8453
CORS_ORIGIN=https://172.20.210.87:8453

# HTTPS aqui não é opcional: com NODE_ENV=production o better-auth marca o
# cookie de sessão como Secure, e sobre HTTP puro o navegador o descarta — o
# login parece funcionar e a sessão não persiste.

# ─── Banco ────────────────────────────────────────────────────────────────────
# Postgres roda FORA do Docker, no host da VM. host.docker.internal resolve
# para o gateway do bridge, declarado via extra_hosts no compose.
# sslmode=disable porque o Postgres local não tem TLS (a produção usa require).
DATABASE_URL=postgresql://portal_cliente_hml:SUBSTITUA_ME@host.docker.internal:5432/portal_cliente?uselibpqcompat=true&sslmode=disable

# ─── Segredos ─────────────────────────────────────────────────────────────────
# Gere NOVOS, diferentes dos de produção: openssl rand -base64 32
# As duas primeiras são lidas no import do better-auth e lançam se faltarem —
# sem elas a API não sobe.
BETTER_AUTH_SECRET=SUBSTITUA_ME_32_OU_MAIS_CARACTERES
BETTER_AUTH_PROVISIONING_SECRET=SUBSTITUA_ME
# Credencial das rotas /api/service/** consumidas pelo Portal Aurora.
SERVICE_API_KEY=SUBSTITUA_ME

# ─── Módulo de averbação ──────────────────────────────────────────────────────
# Uma chave só: o compose a entrega à API como AVERBACAO_ATIVA e ao frontend
# como NEXT_PUBLIC_AVERBACAO_ATIVA. Mudar exige rebuild do frontend, porque
# NEXT_PUBLIC_* é inlinado no bundle.
AVERBACAO_ATIVA=true

# ─── MinIO (container da própria stack) ───────────────────────────────────────
# Credenciais próprias, não as de produção. A API usa este mesmo par para
# verificar/criar o bucket no startup.
MINIO_ROOT_USER=portalminio_hml
MINIO_ROOT_PASSWORD=SUBSTITUA_ME
MINIO_BUCKET_NAME=portal-cliente-hml

# ─── SMTP ─────────────────────────────────────────────────────────────────────
# Dispara e-mail de verdade. Use apenas destinatários de teste em homologação,
# e deixe o remetente identificado — o default do código é o de produção.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portal Cliente HOMOLOGACAO <no-reply@auroraeadi.com.br>
# Link do botão "Abrir o portal" nos e-mails; sem ela cai no FRONTEND_URL.
PORTAL_URL=https://172.20.210.87:8453

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
# O broker é um container da própria stack (serviço `rabbitmq`, vhost
# homologacao). O broker de 172.20.210.85 é o da PRODUÇÃO e não é usado aqui.
#
# RABBITMQ_URL não entra neste arquivo: o compose a monta a partir das duas
# chaves abaixo, para a senha ter uma fonte só. A senha precisa ser URL-safe
# (só letras e números). Usuário/senha só valem na primeira inicialização do
# volume rabbitmq_data_hml.
RABBITMQ_HML_USER=portal_cliente_hml
RABBITMQ_HML_PASSWORD=SUBSTITUA_ME

# O sufixo .hml continua obrigatório, mesmo com broker próprio: é a defesa caso
# a stack seja apontada por engano para um broker compartilhado. Conferência:
#
#   grep -E '^RABBITMQ_(EXCHANGE|RETRY_EXCHANGE|DLX_EXCHANGE|COMMAND|DI_|AGENDAMENTO_|AVERBACAO_|GESTAO_|JANELA_|TRANSPORTADORAS_)' \
#     .env.homolog | grep -v '\.hml$'      # saída vazia = ok

RABBITMQ_EXCHANGE=portal.integration.events.hml
RABBITMQ_RETRY_EXCHANGE=portal.integration.retry.hml
RABBITMQ_DLX_EXCHANGE=portal.integration.dlx.hml
RABBITMQ_COMMAND_EXCHANGE=portal.integration.commands.hml
RABBITMQ_COMMAND_RETRY_EXCHANGE=portal.integration.commands.retry.hml
RABBITMQ_COMMAND_DLX_EXCHANGE=portal.integration.commands.dlx.hml

RABBITMQ_DI_AVERBADA_QUEUE=portal-cliente.dis-averbada.created.hml
RABBITMQ_DI_AVERBADA_RETRY_QUEUE=portal-cliente.dis-averbada.created.retry.30s.hml
RABBITMQ_DI_AVERBADA_DLQ=portal-cliente.dis-averbada.created.dlq.hml
RABBITMQ_DI_DESAVERBADA_QUEUE=portal-cliente.dis-averbada.removed.hml
RABBITMQ_DI_DESAVERBADA_RETRY_QUEUE=portal-cliente.dis-averbada.removed.retry.30s.hml
RABBITMQ_DI_DESAVERBADA_DLQ=portal-cliente.dis-averbada.removed.dlq.hml
RABBITMQ_AVERBACAO_TIPOS_DOCUMENTO_QUEUE=portal-cliente.averbacao.tipos-documento.replicar.hml
RABBITMQ_AVERBACAO_TIPOS_DOCUMENTO_RETRY_QUEUE=portal-cliente.averbacao.tipos-documento.replicar.retry.30s.hml
RABBITMQ_AVERBACAO_TIPOS_DOCUMENTO_DLQ=portal-cliente.averbacao.tipos-documento.replicar.dlq.hml
RABBITMQ_AGENDAMENTO_CANCEL_QUEUE=portal-cliente.agendamento.cancel.requested.hml
RABBITMQ_AGENDAMENTO_CANCEL_RETRY_QUEUE=portal-cliente.agendamento.cancel.requested.retry.30s.hml
RABBITMQ_AGENDAMENTO_CANCEL_DLQ=portal-cliente.agendamento.cancel.requested.dlq.hml
RABBITMQ_AGENDAMENTO_STATUS_CHANGE_QUEUE=portal-cliente.agendamento.status.change.requested.hml
RABBITMQ_AGENDAMENTO_STATUS_CHANGE_RETRY_QUEUE=portal-cliente.agendamento.status.change.requested.retry.30s.hml
RABBITMQ_AGENDAMENTO_STATUS_CHANGE_DLQ=portal-cliente.agendamento.status.change.requested.dlq.hml
RABBITMQ_AVERBACAO_COMMAND_QUEUE=portal-cliente.averbacao.command.requested.hml
RABBITMQ_AVERBACAO_COMMAND_RETRY_QUEUE=portal-cliente.averbacao.command.requested.retry.30s.hml
RABBITMQ_AVERBACAO_COMMAND_DLQ=portal-cliente.averbacao.command.requested.dlq.hml
RABBITMQ_GESTAO_ACESSO_COMMAND_QUEUE=portal-cliente.gestao-acesso.command.requested.hml
RABBITMQ_GESTAO_ACESSO_COMMAND_RETRY_QUEUE=portal-cliente.gestao-acesso.command.requested.retry.30s.hml
RABBITMQ_GESTAO_ACESSO_COMMAND_DLQ=portal-cliente.gestao-acesso.command.requested.dlq.hml
RABBITMQ_TRANSPORTADORAS_QUEUE=portal-cliente.transportadoras.replicar.hml
RABBITMQ_TRANSPORTADORAS_RETRY_QUEUE=portal-cliente.transportadoras.replicar.retry.30s.hml
RABBITMQ_TRANSPORTADORAS_DLQ=portal-cliente.transportadoras.replicar.dlq.hml
RABBITMQ_JANELA_COMMAND_QUEUE=portal-cliente.janela.command.requested.hml
RABBITMQ_JANELA_COMMAND_RETRY_QUEUE=portal-cliente.janela.command.requested.retry.30s.hml
RABBITMQ_JANELA_COMMAND_DLQ=portal-cliente.janela.command.requested.dlq.hml

RABBITMQ_RETRY_DELAY_MS=30000
RABBITMQ_MAX_RETRIES=5

# Consumers de comando vindos do Aurora. Ligue um a um, conforme for validar.
AGENDAMENTO_COMMAND_RABBITMQ_CONSUMER_ENABLED=false
AGENDAMENTO_STATUS_COMMAND_RABBITMQ_CONSUMER_ENABLED=false
AVERBACAO_COMMAND_RABBITMQ_CONSUMER_ENABLED=false
GESTAO_ACESSO_COMMAND_RABBITMQ_CONSUMER_ENABLED=false
JANELA_COMMAND_RABBITMQ_CONSUMER_ENABLED=false

# ─── Agendamento ──────────────────────────────────────────────────────────────
# Minutos que um slot fica reservado antes de liberar.
SLOT_HOLD_MINUTES=10

# ─── Proxy de saída (se a VM exigir) ──────────────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal,minio,portal-cliente-api

# BOOTSTRAP_ADMIN_NAME / _EMAIL / _PASSWORD não entram neste arquivo: são
# passados por `read -s` no momento do bootstrap. Ver doc/HOMOLOGACAO.md.
