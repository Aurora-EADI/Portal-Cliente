{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_*", "NEXT_STANDALONE", "BETTER_AUTH_*", "SERVICE_API_KEY"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**" ]
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "start": { "cache": false, "persistent": true, "passThroughEnv": ["*"] },
    "lint": { "outputs": [] },
    "typecheck": { "dependsOn": [], "outputs": [] }
  }
}
