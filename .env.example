# Variaveis usadas pelo docker-compose.dev.yml.
# Copie para .env.dev e preencha. Nenhum .env real vai para o git.
#
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
# Portas publicadas: frontend 3002, backend 5001, Postgres 5432,
# MinIO 9000 (console 9001).

NODE_ENV=development
ENVIRONMENT=dev
NEXT_PUBLIC_ENVIRONMENT=dev

FRONTEND_URL=http://localhost:3002
BACKEND_URL=http://localhost:5000
FRONTEND_PORT=3002
BACKEND_PORT=5000

# O frontend serve suas proprias Route Handlers em /api (mesma origem).
API_URL=/api

# Origens do browser autorizadas a chamar o backend com credenciais.
# Precisa bater com a porta publicada do frontend.
CORS_ORIGIN=http://localhost:3002

# ──────────────────────────────────────────────────────────
# Banco
# ──────────────────────────────────────────────────────────
DB_USER=postgres
DB_NAME=portal_prod
DB_PASSWORD=troque_esta_senha

# MESMA senha de DB_PASSWORD, porem percent-encoded.
# DB_PASSWORD vai crua para POSTGRES_PASSWORD do servico db; esta aqui entra
# dentro da URL do Prisma, onde caractere como "@" precisa ser escapado
# (admin@123 -> admin%40123). Cru, o parser corta no PRIMEIRO "@" e o host da
# conexao vira "123@db" — o erro que aparece e "could not translate host name".
DB_PASSWORD_URLENC=troque_esta_senha

# Atencao: POSTGRES_PASSWORD so e aplicada quando o volume postgres_data e
# criado. Num volume que ja existe, mudar a senha aqui nao muda a do banco.

# ──────────────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────────────
# Precisa ser o mesmo valor no frontend e no portal-cliente-api.
JWT_SECRET=
JWT_EXPIRES_IN=24h
