# Stack oficial de produção: docker-compose.yml + Traefik externo.
# Copie para .env.prod e substitua todos os placeholders antes de usar.

NODE_ENV=production
PORTAL_HOST=portal-cliente.auroramanaus.com.br
API_URL=/api
FRONTEND_URL=https://portal-cliente.auroramanaus.com.br
BETTER_AUTH_URL=https://portal-cliente.auroramanaus.com.br
BETTER_AUTH_TRUSTED_ORIGINS=https://portal-cliente.auroramanaus.com.br
CORS_ORIGIN=https://portal-cliente.auroramanaus.com.br

# Imagens da produção são publicadas no GHCR; IMAGE_TAG é atualizado pelo deploy.
# GHCR_OWNER deve ser minúsculo (usuário ou organização do GitHub).
GHCR_OWNER=SUBSTITUA_PELO_OWNER_GHCR
IMAGE_TAG=SUBSTITUA_POR_SHA

DB_USER=portaleadi_app
DB_PASSWORD=SUBSTITUA_ME
DB_NAME=portal_agendamento
DB_PORT=5432

BETTER_AUTH_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
BETTER_AUTH_PROVISIONING_SECRET=GERE_OUTRO_SEGREDO_ALEATORIO
SERVICE_API_KEY=SUBSTITUA_ME

# Produção: a API usa o mesmo par root apenas para o provisioning idempotente
# do bucket no startup. Não duplique credenciais do MinIO aqui.
MINIO_ROOT_USER=portalminio
MINIO_ROOT_PASSWORD=SUBSTITUA_ME
MINIO_BUCKET_NAME=portal-cliente

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portal Cliente <no-reply@portal.seudominio.com>

# RabbitMQ externo. Nunca versionar URL real, usuario ou senha.
RABBITMQ_URL=amqps://USUARIO:SENHA@rabbitmq.seudominio.com.br:5671/VHOST
RABBITMQ_EXCHANGE=portal.integration.events
RABBITMQ_RETRY_EXCHANGE=portal.integration.retry
RABBITMQ_DLX_EXCHANGE=portal.integration.dlx
RABBITMQ_DI_AVERBADA_QUEUE=portal-cliente.dis-averbada.created
RABBITMQ_DI_AVERBADA_RETRY_QUEUE=portal-cliente.dis-averbada.created.retry.30s
RABBITMQ_DI_AVERBADA_DLQ=portal-cliente.dis-averbada.created.dlq
RABBITMQ_RETRY_DELAY_MS=30000
RABBITMQ_MAX_RETRIES=5

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,rabbitmq,minio,portal-cliente-api,172.20.210.68
