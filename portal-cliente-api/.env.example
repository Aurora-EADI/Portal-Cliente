# ──────────────────────────────────────────────────────────
# Supabase PostgreSQL — obter em: Project → Settings → Database
# ──────────────────────────────────────────────────────────
# Transaction pooler (porta 6543) — usado em runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (porta 5432) — usado em migrations (prisma migrate deploy)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────────
# Supabase Auth — obter em: Project → Settings → API
# ──────────────────────────────────────────────────────────
SUPABASE_URL="https://[ref].supabase.co"
# Service role key (nunca expor no frontend)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ──────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────
NODE_ENV="production"
# Railway define PORT automaticamente; deixe em branco no painel Railway
# BACKEND_PORT=5001

# CORS — URL do frontend Vercel (sem barra final)
# Múltiplas origens: separar por vírgula
CORS_ORIGIN="https://portal-aurora.vercel.app"
