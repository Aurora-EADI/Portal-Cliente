# ──────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurora_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aurora_dev"

# ──────────────────────────────────────────────────────────
# Auth local (JWT) — mesmo valor precisa estar configurado no frontend
# ──────────────────────────────────────────────────────────
JWT_SECRET="troque_este_segredo"
JWT_EXPIRES_IN="24h"

# ──────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────
NODE_ENV="production"
# Railway define PORT automaticamente; deixe em branco no painel Railway
# BACKEND_PORT=5001

# CORS — URL do frontend Vercel (sem barra final)
# Múltiplas origens: separar por vírgula
CORS_ORIGIN="https://portal-aurora.vercel.app"
