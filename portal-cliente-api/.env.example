# ──────────────────────────────────────────────────────────
# PostgreSQL (SRVPORTALEADIDB)
# ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://portaleadi_app:SUA_SENHA@172.20.210.68:5432/portal_agendamento"
DIRECT_URL="postgresql://portaleadi_app:SUA_SENHA@172.20.210.68:5432/portal_agendamento"

# ──────────────────────────────────────────────────────────
# Better Auth
# ──────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="gere_um_segredo_aleatorio_com_32_ou_mais_caracteres"
BETTER_AUTH_PROVISIONING_SECRET="outro_segredo_aleatorio_apenas_para_o_fluxo_de_convite"
PORTAL_HOST="portal.seudominio.com"
BETTER_AUTH_URL="https://portal.seudominio.com"
BETTER_AUTH_TRUSTED_ORIGINS="https://portal.seudominio.com"
FRONTEND_URL="https://portal.seudominio.com"

# SMTP usado pelo Better Auth para reset de senha
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Portal Cliente <no-reply@portal.seudominio.com>"


# ──────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3030

# Modulo Averbacao Aduaneira. Mesma chave que o frontend recebe como
# NEXT_PUBLIC_AVERBACAO_ATIVA; os dois precisam concordar.
# Ligada, o agendamento exige procuracao vigente do despachante e processo de
# averbacao liberado. Desligada, vale a regra legada.
AVERBACAO_ATIVA=false

# CORS — origens do browser autorizadas a chamar esta API com credenciais.
# Multiplas origens: separar por virgula, sem barra final.
CORS_ORIGIN="https://portal.seudominio.com"

# ──────────────────────────────────────────────────────────
# MinIO — arquivos de procuracao e de averbacao
# ──────────────────────────────────────────────────────────
# Nao ha cliente publico nem URL presigned: todo acesso a arquivo passa por
# streaming autenticado. Ver src/minio/minio.service.ts.
# Usar "localhost" para desenvolvimento local fora do Docker, ou "minio" dentro do Docker.
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET_NAME="averbacao"

# RabbitMQ externo. Somente placeholder; nao versionar URL real.
RABBITMQ_URL="amqps://USUARIO:SENHA@rabbitmq.seudominio.com.br:5671/VHOST"
RABBITMQ_EXCHANGE="portal.integration.events"
RABBITMQ_RETRY_EXCHANGE="portal.integration.retry"
RABBITMQ_DLX_EXCHANGE="portal.integration.dlx"
RABBITMQ_DI_AVERBADA_QUEUE="portal-cliente.dis-averbada.created"
RABBITMQ_DI_AVERBADA_RETRY_QUEUE="portal-cliente.dis-averbada.created.retry.30s"
RABBITMQ_DI_AVERBADA_DLQ="portal-cliente.dis-averbada.created.dlq"
RABBITMQ_RETRY_DELAY_MS=30000
RABBITMQ_MAX_RETRIES=5
