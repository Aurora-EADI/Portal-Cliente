# ──────────────────────────────────────────────────────────
# PostgreSQL (SRVPORTALEADIDB)
# ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://portaleadi_app:SUA_SENHA@172.20.210.68:5432/portal_agendamento"
DIRECT_URL="postgresql://portaleadi_app:SUA_SENHA@172.20.210.68:5432/portal_agendamento"

# ──────────────────────────────────────────────────────────
# Auth local (JWT)
# ──────────────────────────────────────────────────────────
# PRECISA ser identico ao JWT_SECRET do frontend: o Next assina o token de
# sessao e esta API apenas o verifica. O JwtAuthGuard le o cookie httpOnly
# access_token, com header Bearer como fallback. Se os segredos divergirem,
# toda chamada autenticada responde 401 sem indicar a causa.
JWT_SECRET="troque_este_segredo"
JWT_EXPIRES_IN="24h"


# ──────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3030

# CORS — origens do browser autorizadas a chamar esta API com credenciais.
# Multiplas origens: separar por virgula, sem barra final.
CORS_ORIGIN="http://portalcliente.local"

# ──────────────────────────────────────────────────────────
# MinIO — arquivos de procuracao e de averbacao
# ──────────────────────────────────────────────────────────
# Nao ha cliente publico nem URL presigned: todo acesso a arquivo passa por
# streaming autenticado. Ver src/minio/minio.service.ts.
# Usar "localhost" para desenvolvimento local fora do Docker, ou "minio" dentro do Docker.
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET_NAME="averbacao"
