{
  "name": "portal-cliente",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=aurora-eadi-nextjs",
    "dev:api": "turbo run dev --filter=portal-cliente-api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=aurora-eadi-nextjs",
    "build:api": "turbo run build --filter=portal-cliente-api",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "prisma": "pnpm --filter portal-cliente-api exec prisma",
    "db:migrate": "pnpm --filter portal-cliente-api exec prisma migrate dev",
    "db:studio": "pnpm --filter portal-cliente-api exec prisma studio",
    "prisma:generate": "pnpm --filter portal-cliente-api exec prisma generate"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  }
}
