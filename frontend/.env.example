# Copie para .env.local e preencha. Nenhum .env real vai para o git.

NEXT_PUBLIC_ENVIRONMENT=dev
NEXT_PUBLIC_APP_URL=

# API pública, roteada pelo Traefik para o NestJS.
NEXT_PUBLIC_API_URL=/api

# URL opcional para chamadas server-side que não possam usar caminho relativo.
# No browser, prefira /api.
NEXT_PUBLIC_NEST_API_URL=/api
NEST_API_INTERNAL_URL=http://localhost:3030/api

# Averbacao Aduaneira (processos + procuracoes). Desligada: o modulo nao aparece
# na navegacao, /averbacao e /procuracoes respondem 404 e o agendamento volta a
# valer so pela regra legada do Portal Aurora. Ligue com "true" quando a regra
# de negocio entrar em operacao.
# NEXT_PUBLIC_* e inlinado no build do Next — em producao precisa ir como build
# arg, nao so como env de runtime.
NEXT_PUBLIC_AVERBACAO_ATIVA=false
