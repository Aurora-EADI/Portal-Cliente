# Copie para .env.local e preencha. Nenhum .env real vai para o git.

NEXT_PUBLIC_ENVIRONMENT=dev
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Route Handlers do proprio Next (mesma origem). Camada legada.
NEXT_PUBLIC_API_URL=/api

# portal-cliente-api (NestJS) — destino dos modulos novos: averbacao,
# procuracoes, tipos de documento. Valor visto pelo BROWSER, por isso a porta
# publicada no host (5001) e nao a interna do container (5000).
NEXT_PUBLIC_NEST_API_URL=http://localhost:5001/api

# PRECISA ser identico ao JWT_SECRET do portal-cliente-api: o Next assina o
# token e o Nest o verifica. Se divergirem, toda chamada autenticada ao Nest
# responde 401 sem indicar a causa.
JWT_SECRET=
JWT_EXPIRES_IN=24h

DATABASE_URL=postgresql://postgres:senha@localhost:5432/portal_prod
DIRECT_URL=postgresql://postgres:senha@localhost:5432/portal_prod

# Chave compartilhada com o Portal Aurora para as rotas /api/service/**
SERVICE_API_KEY=

# Envio de e-mail (convites, reset de senha)
RESEND_API_KEY=
RESEND_TEST_OVERRIDE_EMAIL=

# Relay de WhatsApp no Portal Aurora
AURORA_RELAY_URL=
AURORA_RELAY_SECRET=
