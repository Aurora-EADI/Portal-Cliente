generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CLIENTE
  DESPACHANTE
  TRANSPORTADORA
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  role       UserRole  @default(EMPLOYEE)
  position   String?
  active     Boolean   @default(true)
  clienteId      String?
  despachanteId  String?
  transportadoraContaId String? @map("transportadora_conta_id")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  moduleAccess UserModuleAccess[]
  cliente      Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  despachante  Despachante?  @relation(fields: [despachanteId], references: [id], onDelete: SetNull)
  transportadoraConta TransportadoraConta? @relation(fields: [transportadoraContaId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Module {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  route       String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAccess  UserModuleAccess[]
  sharedItems ModuleSharedItem[]

  @@map("modules")
}

model ModuleSharedItem {
  id          Int    @id @default(autoincrement())
  moduleId    Int
  targetRoute String
  label       String
  icon        String?
  sortOrder   Int    @default(0)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_shared_items")
}


model UserModuleAccess {
  id        String  @id @default(uuid())
  userId    String
  moduleId  Int
  isEnabled Boolean @default(false)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  module         Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_module_access")
}


enum DIStatus {
  liberada
  bloqueada
  retirado
}

enum AgendamentoStatus {
  ATIVO
  CANCELADO
  CHEGOU
  NO_SHOW
  ON_TIME
  ATRASADO
  AG_CHEGADA
  CONCLUIDO
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?  @unique
  email     String?
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dis             DI[]
  motoristas      Motorista[]
  veiculos        Veiculo[]
  transportadoras Transportadora[]
  users           User[]
  agendamentos    Agendamento[]

  @@map("clientes")
}

model Transportadora {
  id        String   @id @default(uuid())
  clienteId String
  nome      String
  cnpj      String?
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, nome])
  @@map("transportadoras")
}

model DI {
  id             String   @id @default(uuid())
  numeroDI       String   @unique
  clienteId      String
  container      String
  tipoContainer  String
  status         DIStatus @default(bloqueada)
  pesoBruto      Float    @default(0)
  mercadoria     String
  transportadora String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@map("dis")
}

model Motorista {
  id        String   @id @default(uuid())
  clienteId String
  nome      String
  cpf       String
  cnh       String
  telefone  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@unique([clienteId, cpf])
  @@map("motoristas")
}

model Veiculo {
  id        String   @id @default(uuid())
  clienteId String
  placa     String
  modelo    String
  tipo      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@unique([clienteId, placa])
  @@map("veiculos")
}

model JanelaAtendimento {
  id                String   @id @default(uuid())
  descricao         String
  horaInicio        String
  horaFim           String
  intervaloMinutos  Int      @default(60)
  vagasSimultaneas  Int      @default(3)
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("janelas_atendimento")
}


model Agendamento {
  id          String            @id @default(uuid())
  diId        String?
  motoristaId String?
  veiculoId   String?
  clienteId   String?
  data        String
  horario     String
  protocolo   String            @unique
  status      AgendamentoStatus @default(ATIVO)
  observacao  String?
  criadoEm    DateTime          @default(now())

  // Campos do novo formulário de agendamento
  operacao       String?
  subOperacao    String?
  cargaEspecial  Boolean  @default(false)
  servicos       String[]
  tipoVeiculo    String?
  cpfMotorista   String?
  nomeMotorista  String?
  placaVeiculo   String?
  transportadora String?
  empresa        String?
  awbMawb        String?
  diNumero       String?
  dta            String?
  hawb           String?
  numeroVoo      String?
  volumes        String?
  peso           String?
  consignatario  String?
  container      String?
  criadoPorNome  String?   @map("criado_por_nome")
  criadoPorRole  String?   @map("criado_por_role")
  transportadoraContaId String? @map("transportadora_conta_id")

  di        DI?        @relation(fields: [diId], references: [id])
  motorista Motorista? @relation(fields: [motoristaId], references: [id])
  veiculo   Veiculo?   @relation(fields: [veiculoId], references: [id])
  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  transportadoraConta TransportadoraConta? @relation(fields: [transportadoraContaId], references: [id])

  @@map("agendamentos")
}

// ============================================================
// DESPACHANTE — acesso externo para despachantes
// ============================================================

model Despachante {
  id             String   @id @default(uuid())
  codDespachante String   @unique @map("cod_despachante")
  nome           String
  email          String?  @unique
  cnpj           String?  @unique
  telefone       String?
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users        User[]
  disAverbadas DiAverbada[]

  @@map("despachantes")
}

// ============================================================
// DIs AVERBADAS — sincronizadas do Portal Aurora (intranet)
// ============================================================

model DiAverbada {
  id             String    @id @default(uuid())
  nLote          String    @unique @map("n_lote")
  nConhecimento  String?   @map("n_conhecimento")
  dta            String?
  documentoSaida String?   @map("documento_saida")
  tipoDocumento  String?   @map("tipo_documento")
  modalidade     String?
  cliente        String?
  cnpjCliente    String?   @map("cnpj_cliente")
  codDespachante String?   @map("cod_despachante")
  despachante    String?
  saldo          Float?
  dtEntrada      DateTime? @map("dt_entrada")
  localizacao    String?
  containers     String?
  averbadoEm     DateTime  @map("averbado_em")
  sincronizadoEm DateTime  @default(now()) @map("sincronizado_em")
  status         DIStatus  @default(liberada)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  despachanteRef Despachante? @relation(fields: [codDespachante], references: [codDespachante])
  atribuicoes    DiTransportadoraAtribuicao[]

  @@index([cnpjCliente])
  @@index([codDespachante])
  @@map("dis_averbadas")
}

// ============================================================
// TRANSPORTADORA — acesso externo para transportadoras
// ============================================================

model TransportadoraConta {
  id        String   @id @default(uuid())
  cnpj      String   @unique
  nome      String
  codTransp String?  @map("cod_transp")
  email     String?
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  atribuicoes  DiTransportadoraAtribuicao[]
  agendamentos Agendamento[]

  @@map("transportadora_contas")
}

model DiTransportadoraAtribuicao {
  id                    String   @id @default(uuid())
  nLote                 String   @map("n_lote")
  transportadoraContaId String   @map("transportadora_conta_id")
  atribuidoPorUserId    String?  @map("atribuido_por_user_id")
  atribuidoPorRole      String?  @map("atribuido_por_role")
  atribuidoEm           DateTime @default(now()) @map("atribuido_em")

  diAverbada     DiAverbada          @relation(fields: [nLote], references: [nLote], onDelete: Cascade)
  transportadora TransportadoraConta @relation(fields: [transportadoraContaId], references: [id], onDelete: Cascade)

  @@unique([nLote, transportadoraContaId])
  @@index([transportadoraContaId])
  @@map("di_transportadora_atribuicoes")
}

// ============================================================
// CONVITES DE REGISTRO — gerados pelo Portal Aurora
// ============================================================

model ConviteRegistro {
  id             String    @id @default(uuid())
  token          String    @unique @default(uuid())
  tipo           UserRole
  codDespachante String?   @map("cod_despachante")
  cnpjCliente    String?   @map("cnpj_cliente")
  cnpjTransportadora String? @map("cnpj_transportadora")
  codTransp      String?   @map("cod_transp")
  nome           String
  email          String?
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  usedByUserId   String?   @map("used_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("convites_registro")
}
