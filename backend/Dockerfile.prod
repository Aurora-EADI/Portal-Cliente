# =========================
# Build stage
# =========================
FROM node:18-bullseye-slim AS builder

WORKDIR /app

# CA e ferramentas
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  wget && \
  rm -rf /var/lib/apt/lists/*

# Proxy args (opcional)
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# Configuração npm
RUN npm config set registry https://registry.npmjs.org \
  && npm config set fetch-retries 10 \
  && npm config set fetch-retry-mintimeout 30000 \
  && npm config set fetch-retry-maxtimeout 180000 \
  && npm config set fetch-timeout 900000

# Copiar manifests
COPY package.json package-lock.json ./

# Instalar dependências (cache mount acelera rebuilds)
RUN --mount=type=cache,target=/root/.npm npm ci

# Copiar código
COPY . .

# Prisma
RUN npx prisma generate --schema=prisma/postgres/schema.prisma

# Build
RUN npm run build

# Build seed (se necessário)
RUN npx tsc prisma/postgres/seed.ts \
  --esModuleInterop \
  --module nodenext \
  --outDir dist/seed

# =========================
# Production stage
# =========================
FROM node:18-bullseye-slim AS production

WORKDIR /app

# Dependências runtime
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  openssl \
  ca-certificates \
  curl && \
  rm -rf /var/lib/apt/lists/*

# OpenSSL legacy (SQL Server 2008 R2)
RUN cat > /etc/ssl/openssl_legacy.cnf << 'EOL'
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
ssl_conf = ssl_sect

[provider_sect]
default = default_sect
legacy = legacy_sect

[default_sect]
activate = 1

[legacy_sect]
activate = 1

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT@SECLEVEL=0
EOL

ENV OPENSSL_CONF=/etc/ssl/openssl_legacy.cnf

# Proxy args (opcional)
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# Copiar apenas runtime
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

ENV NODE_ENV=production

EXPOSE 5000

# Inicia a aplicação (prisma db push é executado no pipeline antes do deploy)
CMD ["node", "dist/src/main.js"]