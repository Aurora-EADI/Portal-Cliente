# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./

# Configurar npm para ignorar certificados SSL
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NPM_CONFIG_STRICT_SSL=false

# Instalar todas as dependências (incluindo devDependencies para build)
RUN npm ci

# Copiar código fonte
COPY . .

# Gerar clientes Prisma
RUN npx prisma generate --schema=prisma/postgres/schema.prisma
RUN npx prisma generate --schema=prisma/sqlserver/schema.prisma

# Build da aplicação
RUN npm run build

# Compilar o script de seed
RUN npx tsc prisma/postgres/seed.ts --esModuleInterop --module nodenext --outDir dist/seed

# Production stage
FROM node:18-alpine AS production

WORKDIR /app

# Configurar npm
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NPM_CONFIG_STRICT_SSL=false

# Copiar package files
COPY package*.json ./

# Instalar apenas dependências de produção
RUN npm ci --only=production

# Copiar arquivos buildados
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

# Configurações de produção
ENV NODE_ENV=production

EXPOSE 5000

CMD ["node", "dist/src/main.js"]
