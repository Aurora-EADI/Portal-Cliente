# =========================
# Build stage
# =========================
FROM node:20-bullseye-slim AS builder

WORKDIR /app

# CA e ferramentas
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget && \
    rm -rf /var/lib/apt/lists/*

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# Configurar npm ANTES
RUN npm config set registry https://registry.npmmirror.com \
 && npm config set maxsockets 3 \
 && npm config set fetch-retries 10 \
 && npm config set fetch-retry-mintimeout 30000 \
 && npm config set fetch-retry-maxtimeout 180000 \
 && npm config set fetch-timeout 900000 \
 && npm config set strict-ssl false

COPY package*.json ./

# Instalar com retry manual
RUN npm ci || npm ci || npm ci

COPY . .

RUN npx prisma generate --schema=prisma/postgres/schema.prisma
RUN npm run build
RUN npx tsc prisma/postgres/seed.ts \
  --esModuleInterop \
  --module nodenext \
  --outDir dist/seed

# =========================
# Production stage
# =========================
FROM node:20-bullseye-slim AS production

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    curl && \
    rm -rf /var/lib/apt/lists/*

# OpenSSL legacy (SQL Server 2008 R2)
RUN cat > /etc/ssl/openssl_legacy.cnf << 'EOL'
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
ssl_conf = ssl_sect

[provider_sect]
default = default_sect
legacy = legacy_sect

[default_sect]
activate = 1

[legacy_sect]
activate = 1

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT@SECLEVEL=0
EOL

ENV OPENSSL_CONF=/etc/ssl/openssl_legacy.cnf

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

COPY package*.json ./

RUN npm config set registry https://registry.npmmirror.com \
 && npm config set maxsockets 3 \
 && npm config set fetch-retries 10 \
 && npm config set fetch-retry-mintimeout 30000 \
 && npm config set fetch-retry-maxtimeout 180000 \
 && npm config set fetch-timeout 900000 \
 && npm config set strict-ssl false \
 && (npm ci --omit=dev || npm ci --omit=dev || npm ci --omit=dev)

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

ENV NODE_ENV=production

EXPOSE 5000

CMD ["node", "dist/src/main.js"]