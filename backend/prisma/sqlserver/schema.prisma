datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL_SQLSERVER")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
  output        = "../../node_modules/@prisma/client-sqlserver"
}

