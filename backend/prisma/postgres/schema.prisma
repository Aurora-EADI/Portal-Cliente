generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@prisma/client-postgres"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

model Company {
  id                   String                       @id @default(uuid())
  cnpj                 String                       @unique
  fantasyName          String
  socialReason         String
  zipCode              String
  address              String
  number               String
  complement           String?
  neighborhood         String
  city                 String
  state                String
  phone                String
  status               CompanyStatus                @default(PENDING)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  documentRequirements CompanyDocumentRequirement[]
  documents            Document[]
  users                User[]

  @@map("companies")
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  password     String
  role         UserRole
  companyId    String?
  position     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  documents    Document[]
  serviceCosts ServiceCost[]
  simulations  Simulation[]
  moduleAccess UserModuleAccess[]
  tokens       UserToken[]
  company      Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("users")
}

model UserToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([token, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

model Document {
  id              String         @id @default(uuid())
  name            String
  fileType        String
  fileUrl         String
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  companyId       String
  dateExpiration  DateTime?
  dateIssue       DateTime?
  documentTypeId  Int?
  isLatest        Boolean        @default(true)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType    DocumentType?  @relation(fields: [documentTypeId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model DocumentType {
  id                  Int                          @id @default(autoincrement())
  name                String                       @unique
  description         String?
  active              Boolean                      @default(true)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  companyRequirements CompanyDocumentRequirement[]
  documents           Document[]

  @@map("document_types")
}

model CompanyDocumentRequirement {
  id             Int          @id @default(autoincrement())
  companyId      String
  documentTypeId Int
  isRequired     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentTypeId])
  @@map("company_document_requirements")
}

model Permission {
  id          Int                  @id @default(autoincrement())
  key         String               @unique
  description String?
  category    String?
  activities  ActivityPermission[]

  @@map("permissions")
}

model Module {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String?
  active      Boolean            @default(true)
  icon        String?
  route       String?
  activities  Activity[]
  userAccess  UserModuleAccess[]

  @@map("modules")
}

model Activity {
  id          Int                  @id @default(autoincrement())
  name        String
  moduleId    Int
  isMandatory Boolean              @default(false)
  description String?
  module      Module               @relation(fields: [moduleId], references: [id])
  permissions ActivityPermission[]
  userAccess  UserActivityAccess[]

  @@unique([moduleId, name], name: "moduleId_name")
  @@map("activities")
}

model ActivityPermission {
  activityId   Int
  permissionId Int
  activity     Activity   @relation(fields: [activityId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([activityId, permissionId])
  @@map("activity_permissions")
}

model UserModuleAccess {
  id             String               @id @default(uuid())
  userId         String
  moduleId       Int
  isEnabled      Boolean              @default(false)
  activityAccess UserActivityAccess[]
  module         Module               @relation(fields: [moduleId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_module_access")
}

model UserActivityAccess {
  id                 String           @id @default(uuid())
  userModuleAccessId String
  activityId         Int
  isEnabled          Boolean          @default(false)
  activity           Activity         @relation(fields: [activityId], references: [id])
  parentAccess       UserModuleAccess @relation(fields: [userModuleAccessId], references: [id], onDelete: Cascade)

  @@unique([userModuleAccessId, activityId])
  @@map("user_activity_access")
}

model Faturamento {
  id             Int       @id @default(autoincrement())
  cod_cli        String    @db.VarChar(50)
  n_fatura       String    @db.VarChar(50)
  cliente        String    @db.VarChar(255)
  endereco       String?   @db.VarChar(255)
  bairro         String?   @db.VarChar(100)
  cidade         String?   @db.VarChar(100)
  uf             String?   @db.VarChar(2)
  cep            String?   @db.VarChar(10)
  cgc            String?   @db.VarChar(20)
  insc_esta      String?   @db.VarChar(50)
  insc_munic     String?   @db.VarChar(50)
  rps            String?   @db.VarChar(50)
  tp_nota        String?   @db.VarChar(20)
  vl_extenso     String?   @db.VarChar(255)
  valor_fatura   Decimal   @db.Decimal(10, 2)
  valor_servicos Decimal   @db.Decimal(10, 2)
  dt_fatura      DateTime  @db.Date
  dt_vencimento  DateTime  @db.Date
  dt_entrada     DateTime? @db.Date
  iss_cobrar     String?   @db.VarChar(5)
  iss_valor      Decimal?  @db.Decimal(10, 2)
  iss_percentual Decimal?  @db.Decimal(5, 2)
  iii_valor      Decimal?  @db.Decimal(10, 2)
  tributacao_msg String?
  observacao     String?
  modalidade     String?   @db.VarChar(50)
  despachante    String?   @db.VarChar(100)
  valor_cif      Decimal?  @db.Decimal(16, 2)
  n_da           String?   @db.VarChar(50)
  n_di           String?   @db.VarChar(50)
  n_lote         String?   @db.VarChar(50)
  n_conhecimento String?   @db.VarChar(50)
  n_documento    String?   @db.VarChar(50)
  tx_dolar       Decimal?  @db.Decimal(10, 4)
  nr_periodo_i   Int?
  nr_periodo_f   Int?
  dt_periodo_f   DateTime? @db.Date
  qt_volumes     Int?
  peso_bruto     Decimal?  @db.Decimal(10, 2)
  m3             Decimal?  @db.Decimal(10, 2)
  quantidade     Int?
  servico_id     String?   @db.VarChar(50)
  servico        String?
  valor          Decimal?  @db.Decimal(10, 2)
  modalidade_txt String?   @db.VarChar(100)

  @@map("faturamento")
}

model Service {
  id                 String                 @id @default(uuid())
  code               String                 @unique
  name               String
  description        String?
  category           String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  calculationType    ServiceCalculationType @default(FIXED)
  formulaExpression  String?
  hasStripping       Boolean                @default(false)
  serviceCosts       ServiceCost[]
  simulationServices SimulationService[]

  @@map("services")
}

model ServiceCost {
  id         String    @id @default(uuid())
  serviceId  String
  cost       Decimal   @db.Decimal(10, 2)
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  createdBy  String
  reason     String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [createdBy], references: [id])
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, validUntil])
  @@map("service_costs")
}

model Simulation {
  id               String              @id @default(uuid())
  simulationNumber String
  version          Int                 @default(1)
  displayNumber    String
  baseSimulationId String?
  isCurrentVersion Boolean             @default(true)
  versionReason    String?
  customerId       String
  cifUsd           Decimal             @db.Decimal(12, 2)
  dollarRate       Decimal             @db.Decimal(8, 4)
  cifBrl           Decimal             @db.Decimal(12, 2)
  tonnes           Decimal?            @db.Decimal(10, 3)
  cntrCount        Int?
  cntrType         String?
  storageCost      Decimal?            @db.Decimal(10, 2)
  transportCost    Decimal?            @db.Decimal(10, 2)
  discount         Decimal?            @db.Decimal(10, 2)
  totalServices    Decimal?            @db.Decimal(12, 2)
  totalGeneral     Decimal?            @db.Decimal(12, 2)
  status           SimulationStatus    @default(DRAFT)
  hasStripping     Boolean             @default(false)
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  services         SimulationService[]
  baseSimulation   Simulation?         @relation("SimulationVersions", fields: [baseSimulationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions         Simulation[]        @relation("SimulationVersions")
  user             User                @relation(fields: [createdBy], references: [id])
  customer         Customer            @relation(fields: [customerId], references: [id])

  @@unique([simulationNumber, version])
  @@index([customerId, isCurrentVersion])
  @@map("simulations")
}

model SimulationService {
  id           String          @id @default(uuid())
  simulationId String
  serviceId    String
  costType     ServiceCostType @default(DEFAULT)
  originalCost Decimal         @db.Decimal(10, 2)
  appliedCost  Decimal         @db.Decimal(10, 2)
  customReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  service      Service         @relation(fields: [serviceId], references: [id])
  simulation   Simulation      @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, serviceId])
  @@map("simulation_services")
}

enum UserRole {
  ADMIN
  SUPPLIER
  EMPLOYEE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyStatus {
  PENDING
  ACTIVE
  REJECTED
  PENDING_ACTIVE
}

enum TokenType {
  REFRESH
  RESET_PASSWORD
  EMAIL_VERIFICATION
}

enum ServiceCalculationType {
  FIXED
  PERCENTAGE_CIF
  PER_CONTAINER
  PER_TONNE
}

enum SimulationStatus {
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  REJECTED
}

enum ServiceCostType {
  DEFAULT
  CUSTOM
  ZEROED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  document    String         @unique
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  simulations Simulation[]

  @@map("customers")
}
