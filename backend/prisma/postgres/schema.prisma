generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

model Company {
  id                       String                       @id @default(uuid())
  cnpj                     String                       @unique
  fantasyName              String
  socialReason             String
  zipCode                  String
  address                  String
  number                   String
  complement               String?
  neighborhood             String
  city                     String
  state                    String
  phone                    String
  status                   CompanyStatus                @default(PENDING)
  classification           CompanyClassification        @default(ME)
  allocationRegime         AllocationRegime             @default(NO_WORKFORCE_AT_EADI)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  statusChangedAt          DateTime?
  statusReason             String?
  documents                Document[]
  users                    User[]
  documentRequirements     CompanyDocumentRequirement[]
  workforceDocumentRequirements WorkforceDocumentRequirement[]
  supplierTypes            CompanySupplierType[]
  workforce                CompanyEmployee[]
  workforceDocuments       WorkforceDocument[]

  @@map("companies")
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  password     String
  role         UserRole
  companyId    String?
  position     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  documents            Document[]
  workforceDocuments   WorkforceDocument[]     @relation("WorkforceDocumentUploadedBy")
  serviceCosts         ServiceCost[]
  simulationVersions   SimulationVersion[]      @relation("UserSimulationVersions")
  AirSimulationVersion AirSimulationVersion[]   @relation("UserAirSimulationVersions")
  moduleAccess         UserModuleAccess[]
  tokens               UserToken[]
  company              Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("users")
}

model UserToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([token, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

model Document {
  id              String         @id @default(uuid())
  name            String
  fileType        String
  fileUrl         String
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  dateIssue       DateTime?
  dateExpiration  DateTime?
  uploadedAt      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  companyId       String
  documentTypeId  Int?
  isLatest        Boolean        @default(true)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType    DocumentType?  @relation(fields: [documentTypeId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model DocumentType {
  id                         Int                          @id @default(autoincrement())
  name                       String                       @unique
  description                String?
  active                     Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  acceptsPositiveCertificate Boolean                      @default(false)
  frequency                  DocumentFrequency            @default(UNICO)
  hasExpirationControl       Boolean                      @default(false)
  documents                  Document[]
  workforceDocuments          WorkforceDocument[]
  workforceRequirements       WorkforceDocumentRequirement[]
  globalWorkforceRequirements GlobalWorkforceDocumentRequirement[]
  companyRequirements        CompanyDocumentRequirement[]
  requirementRuleItems       DocumentRequirementRuleItem[]

  @@map("document_types")
}

model SupplierType {
  id               String                    @id @default(uuid())
  name             String                    @unique
  description      String?
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  companies        CompanySupplierType[]
  requirementRules DocumentRequirementRule[]

  @@map("supplier_types")
}

model CompanySupplierType {
  companyId      String
  supplierTypeId String
  createdAt      DateTime     @default(now())
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierType   SupplierType @relation(fields: [supplierTypeId], references: [id], onDelete: Cascade)

  @@id([companyId, supplierTypeId])
  @@map("company_supplier_types")
}

model CompanyEmployee {
  id        String   @id @default(uuid())
  companyId String
  fullName  String
  cpf       String
  position  String
  hiredAt   DateTime
  status    EmployeeStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents WorkforceDocument[]

  @@unique([companyId, cpf])
  @@index([companyId])
  @@map("company_employees")
}

model WorkforceDocumentRequirement {
  id             String       @id @default(uuid())
  companyId      String
  documentTypeId Int
  isRequired     Boolean      @default(true)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentTypeId])
  @@index([companyId])
  @@index([documentTypeId])
  @@map("workforce_document_requirements")
}

model GlobalWorkforceDocumentRequirement {
  id             String       @id @default(uuid())
  documentTypeId Int          @unique
  isRequired     Boolean      @default(true)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([active])
  @@map("global_workforce_document_requirements")
}

model WorkforceDocument {
  id               String         @id @default(uuid())
  companyEmployeeId String
  companyId        String
  uploadedByUserId String
  name             String
  fileType         String
  fileUrl          String
  status           DocumentStatus @default(PENDING)
  rejectionReason  String?
  dateIssue        DateTime?
  dateExpiration   DateTime?
  uploadedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  documentTypeId   Int?
  isLatest         Boolean        @default(true)
  companyEmployee  CompanyEmployee @relation(fields: [companyEmployeeId], references: [id], onDelete: Cascade)
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedByUser   User            @relation("WorkforceDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  documentType     DocumentType?   @relation(fields: [documentTypeId], references: [id])

  @@index([companyEmployeeId])
  @@index([companyId])
  @@index([uploadedByUserId])
  @@index([documentTypeId])
  @@index([companyEmployeeId, isLatest])
  @@map("workforce_documents")
}

model DocumentRequirementRule {
  id                    String                  @id @default(uuid())
  companyClassification CompanyClassification
  allocationRegime      AllocationRegime
  supplierTypeId        String
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  supplierType          SupplierType            @relation(fields: [supplierTypeId], references: [id], onDelete: Cascade)
  items                 DocumentRequirementRuleItem[]

  @@unique([companyClassification, allocationRegime, supplierTypeId], name: "requirement_rule_unique_combo")
  @@map("document_requirement_rules")
}

model DocumentRequirementRuleItem {
  id             String                  @id @default(uuid())
  ruleId         String
  documentTypeId Int
  isRequired     Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  rule           DocumentRequirementRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  documentType   DocumentType            @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([ruleId, documentTypeId])
  @@index([documentTypeId])
  @@map("document_requirement_rule_items")
}

model CompanyDocumentRequirement {
  id              String       @id @default(uuid())
  companyId       String
  documentTypeId  Int
  isRequired      Boolean      @default(true)
  isAutomatic     Boolean?     @default(false)
  requirementType String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType    DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentTypeId])
  @@map("company_document_requirements")
}

model Permission {
  id          Int                  @id @default(autoincrement())
  key         String               @unique
  description String?
  category    String?
  activities  ActivityPermission[]

  @@map("permissions")
}

model Module {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String?
  route       String?
  icon        String?
  active      Boolean            @default(true)
  activities  Activity[]
  userAccess  UserModuleAccess[]
  sharedItems ModuleSharedItem[]

  @@map("modules")
}

model ModuleSharedItem {
  id          Int     @id @default(autoincrement())
  moduleId    Int
  targetRoute String
  label       String
  icon        String?
  sortOrder   Int     @default(0)
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_shared_items")
}

model Activity {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  moduleId    Int
  isMandatory Boolean              @default(false)
  route       String?
  label       String?
  icon        String?
  sortOrder   Int                  @default(0)
  module      Module               @relation(fields: [moduleId], references: [id])
  permissions ActivityPermission[]
  userAccess  UserActivityAccess[]

  @@unique([moduleId, name], name: "moduleId_name")
  @@map("activities")
}

model ActivityPermission {
  activityId   Int
  permissionId Int
  activity     Activity   @relation(fields: [activityId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([activityId, permissionId])
  @@map("activity_permissions")
}

model UserModuleAccess {
  id             String               @id @default(uuid())
  userId         String
  moduleId       Int
  isEnabled      Boolean              @default(false)
  activityAccess UserActivityAccess[]
  module         Module               @relation(fields: [moduleId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_module_access")
}

model UserActivityAccess {
  id                 String           @id @default(uuid())
  userModuleAccessId String
  activityId         Int
  isEnabled          Boolean          @default(false)
  activity           Activity         @relation(fields: [activityId], references: [id])
  parentAccess       UserModuleAccess @relation(fields: [userModuleAccessId], references: [id], onDelete: Cascade)

  @@unique([userModuleAccessId, activityId])
  @@map("user_activity_access")
}

model Faturamento {
  id             Int       @id @default(autoincrement())
  cod_cli        String    @db.VarChar(50)
  n_fatura       String    @db.VarChar(50)
  cliente        String    @db.VarChar(255)
  endereco       String?   @db.VarChar(255)
  bairro         String?   @db.VarChar(100)
  cidade         String?   @db.VarChar(100)
  uf             String?   @db.VarChar(2)
  cep            String?   @db.VarChar(10)
  cgc            String?   @db.VarChar(20)
  insc_esta      String?   @db.VarChar(50)
  insc_munic     String?   @db.VarChar(50)
  rps            String?   @db.VarChar(50)
  tp_nota        String?   @db.VarChar(20)
  vl_extenso     String?   @db.VarChar(255)
  valor_fatura   Decimal   @db.Decimal(10, 2)
  valor_servicos Decimal   @db.Decimal(10, 2)
  dt_fatura      DateTime  @db.Date
  dt_vencimento  DateTime  @db.Date
  dt_entrada     DateTime? @db.Date
  iss_cobrar     String?   @db.VarChar(5)
  iss_valor      Decimal?  @db.Decimal(10, 2)
  iss_percentual Decimal?  @db.Decimal(5, 2)
  iii_valor      Decimal?  @db.Decimal(10, 2)
  tributacao_msg String?
  observacao     String?
  modalidade     String?   @db.VarChar(50)
  despachante    String?   @db.VarChar(100)
  valor_cif      Decimal?  @db.Decimal(16, 2)
  n_da           String?   @db.VarChar(50)
  n_di           String?   @db.VarChar(50)
  n_lote         String?   @db.VarChar(50)
  n_conhecimento String?   @db.VarChar(50)
  n_documento    String?   @db.VarChar(50)
  tx_dolar       Decimal?  @db.Decimal(10, 4)
  nr_periodo_i   Int?
  nr_periodo_f   Int?
  dt_periodo_f   DateTime? @db.Date
  qt_volumes     Int?
  peso_bruto     Decimal?  @db.Decimal(10, 2)
  m3             Decimal?  @db.Decimal(10, 2)
  quantidade     Int?
  servico_id     String?   @db.VarChar(50)
  servico        String?
  valor          Decimal?  @db.Decimal(10, 2)
  modalidade_txt String?   @db.VarChar(100)

  @@map("faturamento")
}

model Service {
  id                String                 @id @default(uuid())
  code              String                 @unique
  name              String
  description       String?
  category          String?
  calculationType   ServiceCalculationType @default(FIXED)
  formulaExpression String?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  hasStripping      Boolean                @default(false)
  hasLcl            Boolean                @default(false)
  modal             ServiceModal           @default(BOTH)
  serviceCosts      ServiceCost[]

  @@map("services")
}

model ServiceCost {
  id         String    @id @default(uuid())
  serviceId  String
  cost       Decimal   @db.Decimal(10, 2)
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  createdBy  String
  reason     String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [createdBy], references: [id])
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, validUntil])
  @@map("service_costs")
}

model Simulation {
  id               String              @id @default(uuid())
  simulationNumber String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  customerId       String
  versions         SimulationVersion[]
  customer         Customer            @relation(fields: [customerId], references: [id])

  @@map("simulations")
}

model SimulationVersion {
  id               String              @id @default(uuid())
  simulationId     String
  version          Int
  displayNumber    String
  isCurrentVersion Boolean             @default(true)
  versionReason    String?
  status           SimulationStatus    @default(PENDING)
  cifUsd           Decimal             @db.Decimal(15, 2)
  dollarRate       Decimal             @db.Decimal(10, 4)
  cifBrl           Decimal             @db.Decimal(15, 2)
  tonnes           Decimal?            @db.Decimal(15, 3)
  cntrCount        Int?
  cntrType         String?
  storageCost      Decimal             @default(0) @db.Decimal(15, 2)
  transportCost    Decimal             @default(0) @db.Decimal(15, 2)
  discount         Decimal             @default(0) @db.Decimal(15, 2)
  totalServices    Decimal             @default(0) @db.Decimal(15, 2)
  totalGeneral     Decimal             @default(0) @db.Decimal(15, 2)
  hasStripping     Boolean             @default(false)
  hasLcl           Boolean             @default(false)
  minBillingValue  Decimal             @default(5500) @db.Decimal(10, 2)
  auroraPeriods    Int                 @default(1)
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  baseVersionId    String?
  services         SimulationService[]
  baseVersion      SimulationVersion?  @relation("VersionHistory", fields: [baseVersionId], references: [id])
  nextVersions     SimulationVersion[] @relation("VersionHistory")
  user             User                @relation("UserSimulationVersions", fields: [createdBy], references: [id])
  simulation       Simulation          @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@map("simulation_versions")
}

model SimulationService {
  id              String                 @id @default(uuid())
  versionId       String
  serviceId       String?
  serviceName     String
  serviceCode     String
  calculationType ServiceCalculationType
  hasStripping    Boolean                @default(false)
  hasLcl          Boolean                @default(false)
  costType        ServiceCostType
  originalCost    Decimal                @db.Decimal(10, 2)
  appliedCost     Decimal                @db.Decimal(10, 2)
  customReason    String?
  version         SimulationVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("simulation_services")
}

model Customer {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  document      String          @unique
  status        CustomerStatus  @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  city          String?
  complement    String?
  contact       String?
  corporateName String?
  neighborhood  String?
  number        String?
  state         String?
  street        String?
  zipCode       String?
  AirSimulation AirSimulation[]
  simulations   Simulation[]

  @@map("customers")
}

model AirSimulation {
  id               String                 @id @default(uuid())
  simulationNumber String                 @unique
  customerId       String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  versions         AirSimulationVersion[]
  customer         Customer               @relation(fields: [customerId], references: [id])

  @@map("air_simulations")
}

model AirSimulationVersion {
  id               String                 @id @default(uuid())
  simulationId     String
  version          Int
  displayNumber    String
  isCurrentVersion Boolean                @default(true)
  versionReason    String?
  status           SimulationStatus       @default(PENDING)
  cifUsd           Decimal                @db.Decimal(15, 2)
  dollarRate       Decimal                @db.Decimal(10, 4)
  cifBrl           Decimal                @db.Decimal(15, 2)
  weightKg         Decimal?               @db.Decimal(15, 3)
  volumeM3         Decimal?               @db.Decimal(15, 3)
  storageCost      Decimal                @default(0) @db.Decimal(15, 2)
  transportCost    Decimal                @default(0) @db.Decimal(15, 2)
  discount         Decimal                @default(0) @db.Decimal(15, 2)
  totalServices    Decimal                @default(0) @db.Decimal(15, 2)
  totalGeneral     Decimal                @default(0) @db.Decimal(15, 2)
  minBillingValue  Decimal                @default(350) @db.Decimal(10, 2)
  auroraPeriods    Int                    @default(1)
  vinciPeriods     Int                    @default(1)
  createdBy        String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  baseVersionId    String?
  capataziaCost    Decimal                @default(0) @db.Decimal(15, 2)
  services         AirSimulationService[]
  baseVersion      AirSimulationVersion?  @relation("AirVersionHistory", fields: [baseVersionId], references: [id])
  nextVersions     AirSimulationVersion[] @relation("AirVersionHistory")
  user             User                   @relation("UserAirSimulationVersions", fields: [createdBy], references: [id])
  simulation       AirSimulation          @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@map("air_simulation_versions")
}

model AirSimulationService {
  id              String                    @id @default(uuid())
  versionId       String
  serviceId       String?
  serviceName     String
  serviceCode     String
  calculationType AirServiceCalculationType
  costType        ServiceCostType
  originalCost    Decimal                   @db.Decimal(10, 2)
  appliedCost     Decimal                   @db.Decimal(10, 2)
  customReason    String?
  version         AirSimulationVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, serviceId])
  @@map("air_simulation_services")
}

enum UserRole {
  ADMIN
  SUPPLIER
  EMPLOYEE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyStatus {
  PENDING
  PENDING_ACTIVE
  ACTIVE
  REJECTED
  INACTIVE
  BLOCKED
}

enum TokenType {
  REFRESH
  RESET_PASSWORD
  EMAIL_VERIFICATION
}

enum ServiceCalculationType {
  FIXED
  PERCENTAGE_CIF
  PER_CONTAINER
  PER_TONNE
}

enum SimulationStatus {
  PENDING
  IN_VALIDATION
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  REJECTED
}

enum ServiceCostType {
  DEFAULT
  CUSTOM
  ZEROED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum AirServiceCalculationType {
  FIXED
  PERCENTAGE_CIF
  PER_KG
  PER_TONNE
}

enum DocumentFrequency {
  UNICO
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum CompanyClassification {
  MEI
  ME
  EPP
  EIRELI
}

enum AllocationRegime {
  NO_WORKFORCE_AT_EADI
  FULL_WORKFORCE_AT_EADI
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ServiceModal {
  MARITIME
  AIR
  BOTH
}

// ============ CCTE MODULE ============

enum FlightStatus {
  PENDING
  SENT
}

enum CargoItemStatus {
  EM_ANALISE
  DTA_REGISTRADA
  ENVIADO
}

enum TCOption {
  P
  A
}

enum FlightHistoryType {
  EDIT
  REVERT
}

enum WarehouseReason {
  CV
  MA
  RF
  DOC
  DIV
  MT
  P
}

model Flight {
  id           String          @id @default(uuid())
  aircraftName String
  arrivalDate  DateTime        @db.Date
  arrivalTime  String
  flightCode   String
  status       FlightStatus    @default(PENDING)
  termoEntrada String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  cargoItems   CargoItem[]
  history      FlightHistory[]

  @@map("flights")
}

model CargoItem {
  id           String          @id @default(uuid())
  flightId     String
  number       String?
  house        String
  importer     String
  dta          String          @default("")
  quantity     Int             @default(1)
  tc              TCOption         @default(P)
  warehouseReason WarehouseReason?
  status          CargoItemStatus  @default(EM_ANALISE)
  responsible  String          @default("")
  observations String          @default("")
  sent         Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  flight       Flight          @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@map("cargo_items")
}

model FlightHistory {
  id        String            @id @default(uuid())
  flightId  String
  type      FlightHistoryType
  changes   String
  reason    String
  createdAt DateTime          @default(now())
  flight    Flight            @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@map("flight_history")
}

// ============ DTA MARITIME MODULE ============

model ProcessoImportacao {
  id            String      @id @default(uuid())
  dta           String      @unique
  empresa       String
  porto         String
  navio         String
  ataDta        DateTime?   @db.Date
  ataMao        DateTime?   @db.Date
  ataEadi       DateTime?   @db.Date
  conclusao     DateTime?   @db.Date
  transportador String?
  comissaria    String?
  fobTotal      Decimal?    @db.Decimal(15, 2)
  freteTotal    Decimal?    @db.Decimal(15, 2)
  cifTotal      Decimal?    @db.Decimal(15, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  containers    Container[]
  bls           BillOfLading[]

  @@map("processos_importacao")
}

model Container {
  id         String             @id @default(uuid())
  processoId String
  number     String
  tipo       String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  processo   ProcessoImportacao @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@unique([processoId, number])
  @@map("containers")
}

model BillOfLading {
  id         String             @id @default(uuid())
  processoId String
  numero     String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  processo   ProcessoImportacao @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@unique([processoId, numero])
  @@map("bill_of_ladings")
}

