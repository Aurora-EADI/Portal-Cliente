generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@prisma/client-postgres"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

model Company {
  id                     String                       @id @default(uuid())
  cnpj                   String                       @unique
  fantasyName            String
  socialReason           String
  zipCode                String
  address                String
  number                 String
  complement             String?
  neighborhood           String
  city                   String
  state                  String
  phone                  String
  status                 CompanyStatus                @default(PENDING)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  businessClassification BusinessClassification?
  eadiRegime             EadiRegime?
  statusChangedAt        DateTime?
  statusReason           String?
  documentRequirements   CompanyDocumentRequirement[]
  company_supplier_types company_supplier_types[]
  documents              Document[]
  third_parties          third_parties[]
  users                  User[]

  @@map("companies")
}

model User {
  id                    String                  @id @default(uuid())
  name                  String
  email                 String                  @unique
  password              String
  role                  UserRole
  companyId             String?
  position              String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  AirSimulationVersion  AirSimulationVersion[]  @relation("UserAirSimulationVersions")
  documents             Document[]
  serviceCosts          ServiceCost[]
  simulationVersions    SimulationVersion[]     @relation("UserSimulationVersions")
  third_party_documents third_party_documents[]
  moduleAccess          UserModuleAccess[]
  tokens                UserToken[]
  company               Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("users")
}

model UserToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([token, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

model Document {
  id              String         @id @default(uuid())
  name            String
  fileType        String
  fileUrl         String
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  dateIssue       DateTime?
  dateExpiration  DateTime?
  uploadedAt      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  companyId       String
  documentTypeId  Int?
  isLatest        Boolean        @default(true)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType    DocumentType?  @relation(fields: [documentTypeId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model DocumentType {
  id                                  Int                                   @id @default(autoincrement())
  name                                String                                @unique
  description                         String?
  active                              Boolean                               @default(true)
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime                              @updatedAt
  acceptsPositiveCertificate          Boolean                               @default(false)
  frequency                           DocumentFrequency                     @default(UNICO)
  hasExpirationControl                Boolean                               @default(false)
  companyRequirements                 CompanyDocumentRequirement[]
  documents                           Document[]
  supplier_type_document_requirements supplier_type_document_requirements[]
  third_party_documents               third_party_documents[]

  @@map("document_types")
}

model CompanyDocumentRequirement {
  id              Int                     @id @default(autoincrement())
  companyId       String
  documentTypeId  Int
  isRequired      Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  isAutomatic     Boolean                 @default(false)
  requirementType DocumentRequirementType @default(IMPEDITIVO)
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType    DocumentType            @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentTypeId])
  @@map("company_document_requirements")
}

model Permission {
  id          Int                  @id @default(autoincrement())
  key         String               @unique
  description String?
  category    String?
  activities  ActivityPermission[]

  @@map("permissions")
}

model Module {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String?
  route       String?
  icon        String?
  active      Boolean            @default(true)
  activities  Activity[]
  userAccess  UserModuleAccess[]

  @@map("modules")
}

model Activity {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  moduleId    Int
  isMandatory Boolean              @default(false)
  module      Module               @relation(fields: [moduleId], references: [id])
  permissions ActivityPermission[]
  userAccess  UserActivityAccess[]

  @@unique([moduleId, name], name: "moduleId_name")
  @@map("activities")
}

model ActivityPermission {
  activityId   Int
  permissionId Int
  activity     Activity   @relation(fields: [activityId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([activityId, permissionId])
  @@map("activity_permissions")
}

model UserModuleAccess {
  id             String               @id @default(uuid())
  userId         String
  moduleId       Int
  isEnabled      Boolean              @default(false)
  activityAccess UserActivityAccess[]
  module         Module               @relation(fields: [moduleId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_module_access")
}

model UserActivityAccess {
  id                 String           @id @default(uuid())
  userModuleAccessId String
  activityId         Int
  isEnabled          Boolean          @default(false)
  activity           Activity         @relation(fields: [activityId], references: [id])
  parentAccess       UserModuleAccess @relation(fields: [userModuleAccessId], references: [id], onDelete: Cascade)

  @@unique([userModuleAccessId, activityId])
  @@map("user_activity_access")
}

model Faturamento {
  id             Int       @id @default(autoincrement())
  cod_cli        String    @db.VarChar(50)
  n_fatura       String    @db.VarChar(50)
  cliente        String    @db.VarChar(255)
  endereco       String?   @db.VarChar(255)
  bairro         String?   @db.VarChar(100)
  cidade         String?   @db.VarChar(100)
  uf             String?   @db.VarChar(2)
  cep            String?   @db.VarChar(10)
  cgc            String?   @db.VarChar(20)
  insc_esta      String?   @db.VarChar(50)
  insc_munic     String?   @db.VarChar(50)
  rps            String?   @db.VarChar(50)
  tp_nota        String?   @db.VarChar(20)
  vl_extenso     String?   @db.VarChar(255)
  valor_fatura   Decimal   @db.Decimal(10, 2)
  valor_servicos Decimal   @db.Decimal(10, 2)
  dt_fatura      DateTime  @db.Date
  dt_vencimento  DateTime  @db.Date
  dt_entrada     DateTime? @db.Date
  iss_cobrar     String?   @db.VarChar(5)
  iss_valor      Decimal?  @db.Decimal(10, 2)
  iss_percentual Decimal?  @db.Decimal(5, 2)
  iii_valor      Decimal?  @db.Decimal(10, 2)
  tributacao_msg String?
  observacao     String?
  modalidade     String?   @db.VarChar(50)
  despachante    String?   @db.VarChar(100)
  valor_cif      Decimal?  @db.Decimal(16, 2)
  n_da           String?   @db.VarChar(50)
  n_di           String?   @db.VarChar(50)
  n_lote         String?   @db.VarChar(50)
  n_conhecimento String?   @db.VarChar(50)
  n_documento    String?   @db.VarChar(50)
  tx_dolar       Decimal?  @db.Decimal(10, 4)
  nr_periodo_i   Int?
  nr_periodo_f   Int?
  dt_periodo_f   DateTime? @db.Date
  qt_volumes     Int?
  peso_bruto     Decimal?  @db.Decimal(10, 2)
  m3             Decimal?  @db.Decimal(10, 2)
  quantidade     Int?
  servico_id     String?   @db.VarChar(50)
  servico        String?
  valor          Decimal?  @db.Decimal(10, 2)
  modalidade_txt String?   @db.VarChar(100)

  @@map("faturamento")
}

model Service {
  id                String                 @id @default(uuid())
  code              String                 @unique
  name              String
  description       String?
  category          String?
  calculationType   ServiceCalculationType @default(FIXED)
  formulaExpression String?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  hasStripping      Boolean                @default(false)
  modal             ServiceModal           @default(BOTH)
  serviceCosts      ServiceCost[]

  @@map("services")
}

model ServiceCost {
  id         String    @id @default(uuid())
  serviceId  String
  cost       Decimal   @db.Decimal(10, 2)
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  createdBy  String
  reason     String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [createdBy], references: [id])
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, validUntil])
  @@map("service_costs")
}

model Simulation {
  id               String              @id @default(uuid())
  simulationNumber String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  customerId       String
  versions         SimulationVersion[]
  customer         Customer            @relation(fields: [customerId], references: [id])

  @@map("simulations")
}

model SimulationVersion {
  id               String              @id @default(uuid())
  simulationId     String
  version          Int
  displayNumber    String
  isCurrentVersion Boolean             @default(true)
  versionReason    String?
  status           SimulationStatus    @default(DRAFT)
  cifUsd           Decimal             @db.Decimal(15, 2)
  dollarRate       Decimal             @db.Decimal(10, 4)
  cifBrl           Decimal             @db.Decimal(15, 2)
  tonnes           Decimal?            @db.Decimal(15, 3)
  cntrCount        Int?
  cntrType         String?
  storageCost      Decimal             @default(0) @db.Decimal(15, 2)
  transportCost    Decimal             @default(0) @db.Decimal(15, 2)
  discount         Decimal             @default(0) @db.Decimal(15, 2)
  totalServices    Decimal             @default(0) @db.Decimal(15, 2)
  totalGeneral     Decimal             @default(0) @db.Decimal(15, 2)
  hasStripping     Boolean             @default(false)
  minBillingValue  Decimal             @default(5500) @db.Decimal(10, 2)
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  baseVersionId    String?
  services         SimulationService[]
  baseVersion      SimulationVersion?  @relation("VersionHistory", fields: [baseVersionId], references: [id])
  nextVersions     SimulationVersion[] @relation("VersionHistory")
  user             User                @relation("UserSimulationVersions", fields: [createdBy], references: [id])
  simulation       Simulation          @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@map("simulation_versions")
}

model SimulationService {
  id              String                 @id @default(uuid())
  versionId       String
  serviceId       String?
  serviceName     String
  serviceCode     String
  calculationType ServiceCalculationType
  hasStripping    Boolean                @default(false)
  costType        ServiceCostType
  originalCost    Decimal                @db.Decimal(10, 2)
  appliedCost     Decimal                @db.Decimal(10, 2)
  customReason    String?
  version         SimulationVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("simulation_services")
}

model Customer {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  document      String          @unique
  status        CustomerStatus  @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  city          String?
  complement    String?
  contact       String?
  corporateName String?
  neighborhood  String?
  number        String?
  state         String?
  street        String?
  zipCode       String?
  AirSimulation AirSimulation[]
  simulations   Simulation[]

  @@map("customers")
}

model AirSimulation {
  id               String                 @id @default(uuid())
  simulationNumber String                 @unique
  customerId       String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  versions         AirSimulationVersion[]
  customer         Customer               @relation(fields: [customerId], references: [id])

  @@map("air_simulations")
}

model AirSimulationVersion {
  id               String                 @id @default(uuid())
  simulationId     String
  version          Int
  displayNumber    String
  isCurrentVersion Boolean                @default(true)
  versionReason    String?
  status           SimulationStatus       @default(DRAFT)
  cifUsd           Decimal                @db.Decimal(15, 2)
  dollarRate       Decimal                @db.Decimal(10, 4)
  cifBrl           Decimal                @db.Decimal(15, 2)
  weightKg         Decimal?               @db.Decimal(15, 3)
  volumeM3         Decimal?               @db.Decimal(15, 3)
  storageCost      Decimal                @default(0) @db.Decimal(15, 2)
  transportCost    Decimal                @default(0) @db.Decimal(15, 2)
  discount         Decimal                @default(0) @db.Decimal(15, 2)
  totalServices    Decimal                @default(0) @db.Decimal(15, 2)
  totalGeneral     Decimal                @default(0) @db.Decimal(15, 2)
  minBillingValue  Decimal                @default(350) @db.Decimal(10, 2)
  createdBy        String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  baseVersionId    String?
  capataziaCost    Decimal                @default(0) @db.Decimal(15, 2)
  services         AirSimulationService[]
  baseVersion      AirSimulationVersion?  @relation("AirVersionHistory", fields: [baseVersionId], references: [id])
  nextVersions     AirSimulationVersion[] @relation("AirVersionHistory")
  user             User                   @relation("UserAirSimulationVersions", fields: [createdBy], references: [id])
  simulation       AirSimulation          @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@map("air_simulation_versions")
}

model AirSimulationService {
  id              String                    @id @default(uuid())
  versionId       String
  serviceId       String?
  serviceName     String
  serviceCode     String
  calculationType AirServiceCalculationType
  costType        ServiceCostType
  originalCost    Decimal                   @db.Decimal(10, 2)
  appliedCost     Decimal                   @db.Decimal(10, 2)
  customReason    String?
  version         AirSimulationVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, serviceId])
  @@map("air_simulation_services")
}

model company_supplier_types {
  companyId      String
  supplierTypeId Int
  createdAt      DateTime       @default(now())
  companies      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier_types supplier_types @relation(fields: [supplierTypeId], references: [id], onDelete: Cascade)

  @@id([companyId, supplierTypeId])
}

model supplier_type_document_requirements {
  id              Int                     @id @default(autoincrement())
  supplierTypeId  Int
  documentTypeId  Int
  requirementType DocumentRequirementType @default(IMPEDITIVO)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime
  document_types  DocumentType            @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  supplier_types  supplier_types          @relation(fields: [supplierTypeId], references: [id], onDelete: Cascade)

  @@unique([supplierTypeId, documentTypeId])
}

model supplier_types {
  id                                  Int                                   @id @default(autoincrement())
  name                                String                                @unique
  description                         String?
  active                              Boolean                               @default(true)
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime
  company_supplier_types              company_supplier_types[]
  supplier_type_document_requirements supplier_type_document_requirements[]
}

model third_parties {
  id                    String                  @id
  companyId             String
  name                  String
  cpf                   String
  birthDate             DateTime
  position              String
  status                ThirdPartyStatus        @default(ACTIVE)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  companies             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  third_party_documents third_party_documents[]

  @@unique([companyId, cpf])
}

model third_party_documents {
  id              String         @id
  thirdPartyId    String
  name            String
  fileType        String
  fileUrl         String
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  updatedAt       DateTime
  dateIssue       DateTime?
  dateExpiration  DateTime?
  documentTypeId  Int?
  isLatest        Boolean        @default(true)
  uploadedBy      String
  document_types  DocumentType?  @relation(fields: [documentTypeId], references: [id])
  third_parties   third_parties  @relation(fields: [thirdPartyId], references: [id], onDelete: Cascade)
  users           User           @relation(fields: [uploadedBy], references: [id])
}

enum UserRole {
  ADMIN
  SUPPLIER
  EMPLOYEE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyStatus {
  PENDING
  PENDING_ACTIVE
  ACTIVE
  REJECTED
  INACTIVE
  BLOCKED
}

enum TokenType {
  REFRESH
  RESET_PASSWORD
  EMAIL_VERIFICATION
}

enum ServiceCalculationType {
  FIXED
  PERCENTAGE_CIF
  PER_CONTAINER
  PER_TONNE
}

enum SimulationStatus {
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  REJECTED
}

enum ServiceCostType {
  DEFAULT
  CUSTOM
  ZEROED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum AirServiceCalculationType {
  FIXED
  PERCENTAGE_CIF
  PER_KG
  PER_TONNE
}

enum ServiceModal {
  AIR
  MARITIME
  BOTH
}

enum BusinessClassification {
  MEI
  ME
  EPP
  EIRELI
  LTDA
  SA
  OUTROS
}

enum DocumentRequirementType {
  IMPEDITIVO
  PENDENCIA
}

enum EadiRegime {
  SEM_ALOCACAO
  COM_ALOCACAO_INTEGRAL
}

enum DocumentFrequency {
  UNICO
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum ThirdPartyStatus {
  ACTIVE
  INACTIVE
}
