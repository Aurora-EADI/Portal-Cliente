FROM node:18-alpine

WORKDIR /app

COPY package*.json ./

# Configurar npm para ignorar certificados SSL
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NPM_CONFIG_STRICT_SSL=false

RUN npm install

# Copiar TUDO antes de gerar o Prisma (importante!)
COPY . .

# Gerar AMBOS os clientes Prisma
RUN npx prisma generate --schema=prisma/postgres/schema.prisma
RUN npx prisma generate --schema=prisma/sqlserver/schema.prisma

# Verificar se os clientes foram gerados
RUN ls -la node_modules/.prisma/ || echo "Pasta .prisma não encontrada"
RUN ls -la node_modules/@prisma/ || echo "Pasta @prisma não encontrada"

EXPOSE 5000

CMD ["npm", "run", "dev"]