# Ambiente
NODE_ENV=production
ENVIRONMENT=prod
NEXT_PUBLIC_ENVIRONMENT=prod

# URLs
# FRONTEND_URL=http://172.20.210.84:3000
# BACKEND_URL=http://172.20.210.84:5000
# API_URL=http://172.20.210.84:5000/api
# FRONTEND_URL=http://172.20.210.84
FRONTEND_URL=http://portal.auroraeadi.com.br
BACKEND_URL=http://172.20.210.84
# API_URL com path relativo funciona para ambos (HTTPS domínio e HTTP IP)
API_URL=/api

# Portas
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Database - PRODUÇÃO
DB_HOST=host.docker.internal
DB_PORT=6666
DB_NAME=portal_prod
DB_USER=postgres
DB_PASSWORD=admin@123

# JWT
JWT_SECRET=X9kPmQ2vL7nR4wY8jH1bT6cA3fE5gU0zI9oN2sD4xW7yK2025prod
JWT_EXPIRES_IN=24h

# CORS
# CORS_ORIGIN=http://172.20.210.84:3000
# CORS_ORIGIN=http://172.20.210.84
CORS_ORIGIN=http://172.20.210.84,http://portal.local,http://api.portal.local,http://portal.auroraeadi.com.br

# Logs
LOG_LEVEL=info

# Traefik
TRAEFIK_DASHBOARD=false

# Prisma - PRODUÇÃO
DATABASE_URL=postgresql://postgres:admin%40123@host.docker.internal:6666/portal_prod
DATABASE_URL_POSTGRES=postgresql://postgres:admin%40123@host.docker.internal:6666/portal_prod
DATABASE_URL_SQLSERVER=sqlserver://sql-proxy:1433;database=Aurora_M;user=PORTAL;password=Portal#123;encrypt=true;trustServerCertificate=true

# MinIO - Configuração Interna (para operações do container)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=documents

# MinIO - Configuração Externa (para URLs públicas)
# Acesso direto ao MinIO (sem Traefik) para evitar problemas com assinaturas AWS
MINIO_EXTERNAL_ENDPOINT=172.20.210.84
MINIO_EXTERNAL_PORT=9000
MINIO_EXTERNAL_USE_SSL=false

# Protheus Integration
PROTHEUS_API_KEY=2b4935b9-930b-42e5-b869-123a3eadd843
