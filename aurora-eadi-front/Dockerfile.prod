# =========================
# Build stage
# =========================
FROM node:18-alpine AS builder

WORKDIR /app

# Instalar dependências de sistema necessárias (para alpine)
# Trocar repositórios para HTTP para evitar erro de SSL corporativo
RUN sed -i 's/https/http/' /etc/apk/repositories
RUN apk add --no-cache libc6-compat

# Configurar npm para ignorar erros de SSL (se necessário na rede corp)
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NPM_CONFIG_STRICT_SSL=false

# Configurações de Retry do NPM
RUN npm config set fetch-retries 10 \
    && npm config set fetch-retry-mintimeout 30000 \
    && npm config set fetch-retry-maxtimeout 180000 \
    && npm config set fetch-timeout 900000

# Copiar manifests
COPY package.json package-lock.json ./

# Instalar dependências (usando install em vez de ci para garantir)
RUN npm install

# Copiar código fonte
COPY . .

# Build args
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_KEY

# Environment variables
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_KEY=${NEXT_PUBLIC_API_KEY}
ENV NEXT_TELEMETRY_DISABLED=1

# Build do Next
RUN npm run build

# =========================
# Production stage
# =========================
FROM node:18-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

# Copiar apenas o necessário do builder
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["npm", "run", "start"]
