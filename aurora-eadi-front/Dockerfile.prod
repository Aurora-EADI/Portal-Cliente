# =========================
# Build stage
# =========================
FROM node:18-alpine AS builder

WORKDIR /app

# Instalar dependências de sistema necessárias (para alpine)
# Trocar repositórios para HTTP para evitar erro de SSL corporativo
RUN sed -i 's/https/http/' /etc/apk/repositories
RUN apk add --no-cache libc6-compat

# Configurar npm para ignorar erros de SSL (se necessário na rede corp)
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NPM_CONFIG_STRICT_SSL=false

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

# Configuração npm (mais estável)
RUN npm config set registry https://registry.npmjs.org \
    && npm config set fetch-retries 10 \
    && npm config set fetch-retry-mintimeout 30000 \
    && npm config set fetch-retry-maxtimeout 180000 \
    && npm config set fetch-timeout 900000 \
    && npm config set maxsockets 5

# Copiar manifests
COPY package.json package-lock.json ./

# Instalar dependências (cache mount acelera rebuilds)
RUN --mount=type=cache,target=/root/.npm \
    npm ci --maxsockets=5 || npm ci --maxsockets=3 || npm ci --maxsockets=1

# Copiar código fonte
COPY . .

# Build args
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_KEY

# Environment variables
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_KEY=${NEXT_PUBLIC_API_KEY}
ENV NEXT_TELEMETRY_DISABLED=1

# Build do Next
RUN npm run build

# =========================
# Production stage
# =========================
FROM node:18-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

# Standalone: copia apenas o bundle otimizado (~30-50MB vs ~500MB)
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
