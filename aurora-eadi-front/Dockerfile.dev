FROM node:18-alpine

WORKDIR /app

# Copiar package files
COPY package*.json ./

# Configurar npm para ignorar SSL
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NPM_CONFIG_STRICT_SSL=false

# Instalar dependências
RUN npm install

# Copiar código
COPY . .

# Expor porta
EXPOSE 3000

# IMPORTANTE: Next.js deve ouvir em 0.0.0.0 para aceitar conexões do Docker
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

CMD ["npm", "run", "dev"]